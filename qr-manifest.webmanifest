{
	"name": "VDO.Ninja Serverless Connect",
	"short_name": "VDO QR Connect",
	"description": "Connect two VDO.Ninja peers using QR codes or pasted text without a handshake server.",
	"start_url": "./qr",
	"scope": "./",
	"display": "standalone",
	"background_color": "#14171a",
	"theme_color": "#14171a",
	"orientation": "any",
