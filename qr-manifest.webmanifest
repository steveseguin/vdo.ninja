		{
			"src": "./media/icon-192x192.png",
			"sizes": "192x192",
			"type": "image/png",
			"purpose": "any monochrome"
		},
		{
			"src": "./media/icon-512x512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "any monochrome"
		}
	]
}
